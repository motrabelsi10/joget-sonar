            <entry>
               <string>demande_reclamation::tool3</string>
               <packageActivityPlugin>
                  <processDefId>demande_reclamation</processDefId>
                  <activityDefId>tool3</activityDefId>
                  <pluginName>org.joget.apps.app.lib.MultiTools</pluginName>
                  <pluginProperties>{&quot;runInMultiThread&quot;:&quot;&quot;,&quot;comment&quot;:&quot;update app_fd_demande_reclamation\n-- SET c_statut = \n--     CASE\n--         WHEN &apos;#variable.validation_chef_agent#&apos; = &apos;oui&apos; THEN \n--             CASE \n--                 WHEN &apos;#variable.decision_agent#&apos; in (&apos;&apos;) THEN\n--             ELSE\n--         WHEN performance_rating = &apos;Good&apos; THEN salary * 1.05\n--         ELSE salary\n--     END\n-- WHERE salary &gt; 3000;\n&quot;,&quot;tools&quot;:[{&quot;className&quot;:&quot;org.joget.apps.app.lib.DatabaseUpdateTool&quot;,&quot;properties&quot;:{&quot;query&quot;:&quot;UPDATE app_fd_pmt\r\nSET c_statut_enquete = \r\n    CASE\r\n        WHEN &apos;#variable.validation_chef_agent#&apos; = &apos;oui&apos; THEN \r\n            CASE \r\n                WHEN &apos;#variable.decision_agent#&apos; IN (&apos;Passer à une enquête urgente&apos;, &apos;Passer à une enquête classique&apos;) THEN &apos;A enquêter&apos;\r\n                WHEN &apos;#variable.decision_agent#&apos; = &apos;Passer à une validation communautaire&apos; THEN &apos;A valider&apos;\r\n                ELSE c_statut_enquete\r\n            END\r\n        ELSE\r\n            CASE \r\n                WHEN &apos;#variable.decision_finale#&apos; IN (&apos;Passer à une enquête urgente&apos;, &apos;Passer à une enquête classique&apos;) THEN &apos;A enquêter&apos;\r\n                WHEN &apos;#variable.decision_finale#&apos; = &apos;Passer à une validation communautaire&apos; THEN &apos;A valider&apos;\r\n                ELSE c_statut_enquete\r\n            END\r\n    END\r\nWHERE id = (\r\n    SELECT pmt.id \r\n    FROM app_fd_table_individus i \r\n    JOIN app_fd_d_preinscription p ON (p.c_npi = i.c_numero_npi)\r\n    JOIN app_fd_pmt pmt ON (i.c_id_enquete = pmt.id) \r\n    WHERE p.c_npi = &apos;#variable.npi#&apos;\r\n    LIMIT 1\r\n);&quot;,&quot;jdbcDatasource&quot;:&quot;default&quot;}}]}</pluginProperties>
               </packageActivityPlugin>
            </entry>
